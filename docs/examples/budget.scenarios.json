{
  "version": 1,
  "recipe": {
    "version": 1,
    "source": {"table_name": "Budget"},
    "group_by": ["Unit"],
    "metrics": [
      {"op": "sum", "field": "Budget", "as": "Total"},
      {"op": "count", "as": "Projects"}
    ],
    "output": {"sheet_name": "UnusedReport", "range_ref": "A1:C20"}
  },
  "key_fields": ["Id"],
  "guards": [
    {"metric": "Total", "scope": "overall", "max": 100000},
    {"metric": "Total", "scope": "each_group", "min": 10000}
  ],
